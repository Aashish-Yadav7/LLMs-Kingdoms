# OpenRouter (one key, many models -- deepseek/kimi/qwen/glm/gemini/gpt/claude/grok all reachable here)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (fully local + free, no key needed) -- only used if a kingdom's
# model string starts with "ollama/", e.g. "ollama/llama3.1". Default below
# assumes Ollama is running on your machine with default settings; change
# only if you're running it elsewhere.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq (free tier, very fast inference) -- only used if a kingdom's model
# string starts with "groq/", e.g. "groq/llama-3.3-70b-versatile".
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: point at your own hosted model instead of OpenRouter for one kingdom.
# If set, kingdoms with model starting with "custom/" will use this instead.
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
