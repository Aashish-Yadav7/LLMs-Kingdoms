*** ============================================================
# WHICH MODEL EACH KINGDOM USES -- edit these five lines to swap
# providers per kingdom without touching any code. Leave a line
# blank/absent and that kingdom falls back to Ollama (free, local).
# Format: "<provider_prefix>/<model_name>"
#   ollama/llama3.2                       free, local, default
#   cerebras/gpt-oss-120b                  free tier (has hit payment walls)
#   nvidia/meta/llama-3.1-70b-instruct     free tier
#   groq/llama-3.3-70b-versatile           free tier
#   openrouter/free                        free auto-router
#   xai/grok-4.3                           NOT FREE, real billing
#   custom/your-model-id                   your own hosted endpoint
*** ============================================================
NORTH_MODEL=ollama/llama3.2
EAST_MODEL=ollama/llama3.2
SOUTH_MODEL=ollama/llama3.2
WEST_MODEL=ollama/llama3.2
PLAYER_LLM_MODEL=ollama/llama3.2

# ============================================================
# PROVIDER CREDENTIALS -- each block below is a separate "hotel".
# A key only works with its own block's base URL, never mix them.
# You only need to fill in whichever providers you actually
# referenced above. Ollama needs nothing filled in at all.
# ============================================================

# --- Ollama --- fully local, no key needed, just install & run it
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OpenRouter --- free at https://openrouter.ai/keys, no card
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Cerebras --- free at https://cloud.cerebras.ai, no card (keys start "csk-")
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- NVIDIA Build (NIM) --- free at https://build.nvidia.com, no card (keys start "nvapi-")
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Groq --- free at https://console.groq.com/keys, no card (keys start "gsk_")
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- xAI (Grok) --- NOT FREE, real per-token billing, card required
# eventually. Only fill this in if you're deliberately choosing to pay.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# --- Your own custom-hosted model ---
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=


